# Copy to .env and fill in values (.env is gitignored).

# --- React app (browser) ---
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key
REACT_APP_OPENAI_API_KEY=your-openai-key

# --- Candidate matcher worker (scripts/candidate-matcher, npm run matcher:*) ---
# Supabase Dashboard → Project Settings → API → service_role (secret). Never prefix with REACT_APP_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional aliases (same value as above):
# SUPABASE_SERVICE_KEY=
# OpenAI — matcher embeddings (worker calls api.openai.com directly)
OPENAI_API_KEY=your-openai-key

# OpenClaw — matcher scoring only (optional with --skip-openclaw)
OPENCLAW_GATEWAY_TOKEN=your-openclaw-gateway-token
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_MODEL=openclaw/default
OPENCLAW_MATCHER_USER=skillscout-scout

# Matcher tuning (optional)
# MATCHER_TOP_K=15
# MATCHER_VECTOR_THRESHOLD=0.65
# MATCHER_CONFIDENCE_THRESHOLD=70
